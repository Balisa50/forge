generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  free
  pro
  team
}

enum AccountabilityMode {
  daily
  weekday
  custom
  weekly
  monthly
}

enum TaskStatus {
  locked
  available
  in_progress
  pending_verification
  verified
  failed
}

enum CheckinStatus {
  passed
  failed
  grace
  respite
}

// Only positive integrity events — no deductions, no surveillance
enum IntegrityEvent {
  clean_streak
  perfect_defence
  helped_peer
  own_words
}

enum UserRole {
  learner
  student
  mentor
  bootcamp
}

enum LearningStyle {
  balanced       // default — mix of theory + practice
  hands_on       // minimize reading, maximize building
  theory_first   // foundations, mental models, then apply
  spaced         // short daily doses, lots of review
  sprint         // long focused blocks, fewer sessions
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String
  timezone         String    @default("UTC")
  tier             Tier      @default(free)
  integrityScore   Int       @default(0)
  bio              String?
  github           String?
  linkedin         String?
  role             UserRole  @default(learner)
  isAlsoLearning   Boolean   @default(false)
  learningStyle    LearningStyle @default(balanced)
  onboardingDone   Boolean   @default(false)
  isPublic         Boolean   @default(true)
  /// Opt-in: when true, the learner's first name appears in the public
  /// Build Feed alongside their verified weeks. Default false — anonymous
  /// participation by default, named participation by choice.
  showInFeed       Boolean   @default(false)
  isGuest          Boolean   @default(false)
  /// True when the account was created via mentor join code (no password
  /// signup). These users sign in via their stored recoveryToken or via
  /// cookie persistence; the login form doesn't apply to them.
  isCodeOnly       Boolean   @default(false)
  /// Long random token that lets a code-only mentee sign back in on a new
  /// device. Stored hashed-free because it's the user's only key — they
  /// hold the secret in their bookmark, we just look it up.
  recoveryToken    String?   @unique
  /// Human-typeable personal ID for mentees to return on any device.
  /// Format: ALPHA-XXXX-YYYY. Issued by the mentor at invite time.
  personalId       String?   @unique
  stripeCustomerId String?
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  roadmaps          Roadmap[]
  checkins          Checkin[]
  integrityLogs     IntegrityLog[]
  graceDays         GraceDay[]
  orgMemberships    OrgMembership[]
  mentoring         MentorLink[]     @relation("MentorUser")
  mentees           MentorLink[]     @relation("MenteeUser")
  commentsAsMentor  MentorComment[]  @relation("MentorCommentMentor")
  commentsAsMentee  MentorComment[]  @relation("MentorCommentMentee")
  resourcesGiven    MentorResource[] @relation("MentorResourceMentor")
  resourcesReceived MentorResource[] @relation("MentorResourceMentee")
  aiMentorInteractions AIMentorInteraction[]
  forgePact         ForgePact?
  /// The name MENTEES see for this mentor everywhere in-app (dashboard,
  /// suspension letter, notes). Lets a mentor mentor under a persona so
  /// mentees use in-app messaging instead of personal channels. Falls
  /// back to `name` when null.
  mentorDisplayName String?
  mentorInvites     MentorInvite[]   @relation("MentorInviteMentor")
  mentorQuestions   MentorQuestion[] @relation("MentorQuestionMentor")
  certificates      Certificate[]
  cohortEnrollments CohortEnrollment[]
  podMemberships    PodMember[]
  notifications     Notification[]
  learningProgress  LearningProgress[]
  examProgress      ExamProgress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Roadmap {
  id               String              @id @default(cuid())
  userId           String
  title            String
  description      String?
  mode             AccountabilityMode  @default(daily)
  commitDays       Int[]
  startedAt        DateTime            @default(now())
  targetDate       DateTime?
  dailyDeadlineHour Int               @default(23)
  isActive         Boolean             @default(true)
  cohortId         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort      Cohort?  @relation(fields: [cohortId], references: [id])
  tracks      Track[]
  checkins    Checkin[]
  graceDays   GraceDay[]
  certificates Certificate[]
}

model Track {
  id        String   @id @default(cuid())
  roadmapId String
  title     String
  color     String   @default("#00c8ff")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  phases    Phase[]
  checkins  Checkin[]
}

model Phase {
  id          String   @id @default(cuid())
  trackId     String
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  track     Track      @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id             String     @id @default(cuid())
  phaseId        String
  title          String
  detail         String
  why            String?
  starterCode    String?
  resources      String[]
  milestone      String?
  estimatedHours Float?
  deadline       DateTime?  // when this released week auto-closes (mentor-set)
  releasedAt     DateTime?  // when mentor released this week to the mentee
  releasedBy     String?    // mentor user id who released it
  closedAt       DateTime?  // when the week hard-locked (deadline hit or mentor closed)
  sortOrder      Int        @default(0)
  status         TaskStatus @default(locked)
  verifiedAt     DateTime?
  /// Mentor's 1–5 depth rating set at verification time. Powers the
  /// future Forge Score. Null for unverified tasks and for legacy
  /// verifications that pre-date the rating UI.
  mentorRating   Int?
  /// Implementation intention (Gollwitzer) - the student commits to WHEN,
  /// WHERE, and WHAT FIRST before the week opens. Highest-ROI behavioural
  /// lever in the research. Set once when the week is released.
  intentWhen     String?
  intentWhere    String?
  intentFirst    String?
  intentSetAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  phase            Phase             @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  checkins         Checkin[]
  mentorComments   MentorComment[]
  mentorResources  MentorResource[]
  mentorQuestions  MentorQuestion[]
  aiMentorInteractions AIMentorInteraction[]
}

model Checkin {
  id           String        @id @default(cuid())
  userId       String
  roadmapId    String
  trackId      String
  taskId       String
  description  String
  evidenceType String        @default("url")
  evidenceUrl  String?
  evidenceData Json?
  status       CheckinStatus @default(passed)
  attemptNum   Int           @default(1)
  createdAt    DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap       Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  track         Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  interrogation Interrogation?
}

model Interrogation {
  id               String    @id @default(cuid())
  checkinId        String    @unique
  passed           Boolean   @default(false)
  isDefence        Boolean   @default(false)
  overallScore     Float     @default(0)
  feedback         String?
  /// Mixed-content transcript: open-ended Q&A + proctor snapshots + integrity events.
  /// Schema is `Array<{ role, content, ... }>` with kind = "question"|"answer"|"snapshot"|"event".
  transcript       Json      @default("[]")
  tokensUsed       Int       @default(0)
  /// "ai_solo" (AI Professor grades) | "mentor_async" (mentor authored + grades)
  mode             String    @default("ai_solo")
  /// When mode = mentor_async, set to the mentor who graded. Used by mentee's UI.
  mentorReviewerId String?
  mentorReviewedAt DateTime?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  checkin          Checkin   @relation(fields: [checkinId], references: [id], onDelete: Cascade)
}

/// A question the mentor pre-writes for one of a mentee's tasks.
/// When the mentee starts the interrogation for that task, FORGE serves
/// these in order instead of generating with AI. After all answers are
/// submitted, the interrogation goes into the mentor's review queue.
model MentorQuestion {
  id           String   @id @default(cuid())
  taskId       String
  mentorId     String
  position     Int      @default(0)
  prompt       String
  /// Hidden from the mentee; visible to the mentor during grading.
  rubric       String?
  /// Optional reference answer the mentor wrote (helps when they grade later).
  idealAnswer  String?
  isActive     Boolean  @default(true)
  /// When the mentor explicitly "sent" this question to the student. NULL means
  /// it's still a draft (visible only to the mentor). Student-facing queries
  /// filter on publishedAt IS NOT NULL. Existing rows are backfilled to
  /// createdAt by the migration so nothing already in the wild changes.
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentor       User     @relation("MentorQuestionMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([taskId, mentorId, isActive])
  @@index([taskId, publishedAt])
}

model IntegrityLog {
  id          String          @id @default(cuid())
  userId      String
  event       IntegrityEvent
  description String
  scoreBefore Int
  scoreAfter  Int
  delta       Int
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GraceDay {
  id        String   @id @default(cuid())
  userId    String
  roadmapId String
  usedAt    DateTime @default(now())
  month     Int
  year      Int

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

// ─── Certificates & Verification ────────────────────────────────────────

model Certificate {
  id                 String   @id @default(cuid())
  userId             String
  roadmapId          String
  title              String
  verifyCode         String   @unique @default(cuid())
  totalTasks         Int
  totalHours         Float
  passRate           Float    @default(0)
  /// HMAC-SHA256 signature over (id|userId|roadmapId|title|totalTasks|totalHours|passRate|issuedAt)
  /// using CERT_SECRET. Lets us verify a certificate without trusting the DB row alone.
  signature          String?
  /// Persona name of the mentor who released this cert (or null for self-issued
  /// solo-learner certs). Baked in at issue time so a mentor renaming themselves
  /// later doesn't retroactively change historical certs.
  signedBy           String?
  /// The User.id of the mentor who released this cert. Nullable for legacy
  /// self-issued certs.
  releasedByMentorId String?
  /// Cohort name at time of issue, e.g. "Cohort 4". Null for individual / solo learners.
  cohort             String?
  issuedAt           DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

// ─── B2B: Organizations, Cohorts, Mentoring ────────────────────────────

enum OrgRole {
  owner
  admin
  instructor
  mentor
  student
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  description   String?
  website       String?
  inviteCode    String   @unique @default(cuid())
  maxSeats      Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       OrgMembership[]
  cohorts       Cohort[]
  resources     OrgResource[]
  mentorLinks   MentorLink[]
}

model OrgMembership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole  @default(student)
  joinedAt  DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Cohort {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  roadmapTemplateId String?
  startDate   DateTime
  deadline    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enrollments CohortEnrollment[]
  roadmaps    Roadmap[]
  resources   OrgResource[]
}

model CohortEnrollment {
  id        String   @id @default(cuid())
  cohortId  String
  userId    String
  enrolledAt DateTime @default(now())
  dropped    Boolean  @default(false)
  droppedAt  DateTime?

  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
}

model MentorLink {
  id        String   @id @default(cuid())
  mentorId  String
  menteeId  String
  orgId     String?
  note      String?
  isActive  Boolean  @default(true)
  /// Mentor-controlled visibility flags for what the mentee sees in their
  /// dashboard. Stored as JSON so we can grow the surface without further
  /// migrations. Shape: { pod: boolean, certificates: boolean, analytics: boolean, journal: boolean, leaderboard: boolean }
  /// Missing keys default to TRUE (visible) so existing rows aren't broken.
  visibility Json?
  /// Mentor-controlled suspension. When bannedAt is set, the mentee is locked
  /// out of the whole app and sees a suspension letter on login. The mentor
  /// who set it is the only one who can lift it (set bannedAt back to null).
  bannedAt   DateTime?
  banReason  String?
  /// One-time appeal message the suspended mentee can send. Null = no appeal
  /// sent yet. Once set it cannot be overwritten — the mentee gets one shot.
  banAppeal   String?
  banAppealAt DateTime?
  createdAt DateTime @default(now())

  mentor    User          @relation("MentorUser", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    User          @relation("MenteeUser", fields: [menteeId], references: [id], onDelete: Cascade)
  org       Organization? @relation(fields: [orgId], references: [id])

  @@unique([mentorId, menteeId])
}

/// A message in the mentor-mentee thread, scoped to one task (one week).
/// `authorRole` is either "mentor" or "mentee" so the same row supports both
/// sides of the conversation. `kind` differentiates regular notes from
/// "request_unlock" pings the mentee can fire.
/// `readAt` is set when the OTHER party has seen the message.
model MentorComment {
  id             String    @id @default(cuid())
  taskId         String
  mentorId       String
  menteeId       String
  authorRole     String    @default("mentor") // "mentor" | "mentee"
  kind           String    @default("note")    // "note" | "request_unlock" | "action_log"
  body           String
  readAt         DateTime?
  /// Mentee-side soft delete. Mentor still sees the row in their audit trail;
  /// the mentee's /dashboard/notes filters these out.
  hiddenByMentee Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentor    User @relation("MentorCommentMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    User @relation("MentorCommentMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([menteeId, taskId])
  @@index([mentorId, menteeId])
  @@index([menteeId, hiddenByMentee])
}

/// Per-item engagement on /learn/[slug]/[week] pages. Previously this was
/// localStorage-only, so the server couldn't gate submissions on actual
/// engagement. Now every link-click and radio-tick is persisted as a row.
model LearningProgress {
  id          String   @id @default(cuid())
  userId      String
  slug        String
  week        Int
  itemKey     String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug, week, itemKey])
  @@index([userId, slug, week])
}

/// Account-backed mastery + spaced-repetition progress for the actuary exam
/// paths (/learn/exam/[slug]). Previously localStorage-only, so progress was
/// per-device and lost on a cache clear. Now persisted per user so it survives
/// and syncs across devices. localStorage stays as an offline/instant cache.
/// One row per (user, slug, concept). Mirrors the client ConceptProgress shape.
model ExamProgress {
  id         String    @id @default(cuid())
  userId     String
  slug       String    // "exam-p" / "exam-fm"
  conceptId  String
  status     String    @default("not-started") // not-started | in-progress | mastered
  best       Float     @default(0)              // best quiz score, fraction 0–1
  attempts   Int       @default(0)
  box        Int       @default(0)              // SM-2-lite review box
  dueAt      DateTime?                           // next review due (mastered only)
  masteredAt DateTime?
  lastSeen   DateTime?
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug, conceptId])
  @@index([userId, slug])
}

/// AI Mentor interaction log. Every release / verification / question / warning
/// from THE PROFESSOR persona is stored so the AI has memory across sessions
/// and so we can audit + budget API costs.
///
/// Feature-flag gated - rows are only created when AI_MENTOR_ENABLED=true.
model AIMentorInteraction {
  id           String   @id @default(cuid())
  userId       String
  taskId       String?
  /// "release" | "verification" | "question" | "warning"
  kind         String
  /// User-facing message the AI Mentor produced (in The Professor's voice).
  response     String
  /// "verified" | "needs_work" | "rejected" | null (only set for verifications).
  verdict      String?
  /// Running count of warnings issued to this user for THIS task.
  /// Used by the persona's escalation rules (3 strikes -> recommend human mentor).
  warningCount Int      @default(0)
  /// JSON blob of evidence the AI inspected: github URL, file IDs, screenshot
  /// URLs, raw mastery answers. Keeps the audit trail.
  evidence     Json?
  /// Approximate API tokens used by this interaction. Lets us track cost.
  tokensUsed   Int?
  /// USD cost of this interaction (computed from tokens at known per-model rates).
  costUsd      Float?
  createdAt    DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, taskId])
  @@index([userId, createdAt])
}

/// The Forge Pact - a binding written commitment every learner signs before
/// they can begin. Grounded in commitment-device research (Karlan/Ayres) and
/// identity-based behaviour change. The student writes WHY they are really
/// doing this, what they LOSE if they quit, and WHO they are becoming - then
/// signs it. The Pact is shown back to them whenever they slip: it is the
/// psychological anchor of FORGE accountability.
model ForgePact {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// The student's deeper reason - in their own words.
  why       String
  /// What it costs them if they abandon this - the stake.
  stake     String
  /// The identity they are forging ("I am becoming someone who...").
  identity  String
  /// Typed full-name signature.
  signature String
  signedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Invite code a mentor generates so learners can pair with them.
///
/// One mentor can have many active codes, each scoped to a specific
/// curated roadmap path (the one they're qualified to mentor). A code
/// can be one-time (`maxUses=1`) or unlimited (`maxUses=null`).
/// When a mentee redeems the code:
///   - a MentorLink(mentorId, menteeId) is created
///   - if roadmapSlug is set, the mentee's onboarding pre-selects it
model MentorInvite {
  id          String    @id @default(cuid())
  code        String    @unique // human-typeable, 10 chars
  mentorId    String
  /// Curated roadmap slug this invite mentors on (null = mentor's choice with mentee)
  roadmapSlug String?
  /// Optional friendly label so a mentor can have several codes
  label       String?
  maxUses     Int?      // null = unlimited
  usesCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  /// Mentor pre-registers the mentee's full name. Join is REJECTED unless the
  /// name the mentee types matches this (case-insensitive, trimmed).
  expectedName     String?
  /// The personal ID that will be assigned to the mentee who consumes this
  /// invite. Pre-generated at invite time so the mentor sees BOTH codes upfront
  /// and can hand them over together.
  personalIdIssued String?   @unique
  /// Single-use marker: set to the mentee user id when redeemed. Once set,
  /// nobody else can use this invite.
  consumedByUserId String?

  mentor      User      @relation("MentorInviteMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId, isActive])
}

/// In-app notification. Created whenever a significant event happens
/// (week released, message sent, etc.). Shown in the nav bell.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
}

/// An extra resource a mentor grants to one mentee for a specific task.
/// Shows up inline on the mentee's roadmap alongside the curated resources.
model MentorResource {
  id         String   @id @default(cuid())
  taskId     String
  mentorId   String
  menteeId   String
  title      String
  url        String
  note       String?
  createdAt  DateTime @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentor    User @relation("MentorResourceMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    User @relation("MentorResourceMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([menteeId, taskId])
  @@index([mentorId, menteeId])
}

model OrgResource {
  id          String   @id @default(cuid())
  orgId       String
  cohortId    String?
  title       String
  description String?
  url         String?
  fileUrl     String?
  fileType    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cohort      Cohort?      @relation(fields: [cohortId], references: [id])
}

// ─── Accountability Pods ───────────────────────────────────────────────────

model Pod {
  id        String      @id @default(cuid())
  name      String
  category  String      // "Frontend", "Backend", "Data & AI", etc.
  maxSize   Int         @default(5)
  isOpen    Boolean     @default(true)
  createdAt DateTime    @default(now())

  members   PodMember[]
}

model PodMember {
  id        String   @id @default(cuid())
  podId     String
  userId    String
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())

  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
}

/// A learning application. Someone interested in FORGE applies via the public
/// /apply page; a mentor reviews it and either approves (which generates a
/// name-locked MentorInvite code for them) or rejects it. The act of applying
/// is itself the first commitment - selectivity is on-brand for FORGE.
model MentorApplication {
  id             String    @id @default(cuid())
  applicantName  String
  applicantEmail String
  /// Curated roadmap slug they want to learn (nullable - undecided is allowed).
  trackSlug      String?
  /// Why they want this - their motivation, in their own words.
  motivation     String
  /// How much time per week they can commit.
  commitment     String?
  /// "pending" | "approved" | "rejected"
  status         String    @default("pending")
  /// Mentor user id who reviewed it.
  reviewedById   String?
  /// The MentorInvite code generated when approved - the mentor hands this over.
  inviteCode     String?
  /// Which mentor this application is scoped to. Set when the applicant used
  /// a per-mentor apply link (/apply/[mentorId]). Null = submitted via global /apply.
  mentorId       String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([status, createdAt])
  @@index([mentorId, status])
}
